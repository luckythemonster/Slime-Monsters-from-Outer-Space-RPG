    {
      "run": "dev_subroutine"
    },
    {
      "label": "loop"
    },
    {
      "inc": {
        "vars.loopCount": 1
      }
    },
    {
      "if": "vars.loopCount < 2",
      "then": [
        {
          "goto": "loop"
        }
      ]
    },
    {
      "camera": {
        "follow": "player"
      }
    },
    {
      "despawn": "ryan"
    },
    {
      "party": {
        "add": "phoenix"
      }
    },
    {
      "party": {
        "heal": true
      }
    },
    {
      "give": {
        "money": 10
      }
    },
    {
      "take": {
        "money": 3
      }
    },
    {
      "give": {
        "item": "coffee",
        "qty": 2
      }
    },
    {
      "take": {
        "item": "coffee",
        "qty": 1
      }
    },
    {
      "set": {
        "flags.cutsceneDone": true
      }
    },
    {
      "end": true
    },
    {
      "set": {
        "flags.unreachable": true
      }
    }
  ],
