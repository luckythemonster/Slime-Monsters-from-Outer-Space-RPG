{
  "dev_phoenix": [
    {
      "face": {
        "who": "phoenix",
        "toward": "player"
      }
    },
    {
      "if": "!flags.metPhoenix",
      "then": [
        {
          "emote": {
            "who": "phoenix",
            "type": "!"
          }
        },
        {
          "say": "Oh. You're the slime from the dumpster.",
          "who": "phoenix"
        },
        {
          "set": {
            "flags.metPhoenix": true
          }
        },
        {
          "inc": {
            "vars.phoenixTalks": 1
          }
        },
        {
          "choice": [
            {
              "text": "Want a pizza slice?",
              "then": [
                {
                  "give": {
                    "item": "pizza_slice",
                    "qty": 1
                  }
                },
                {
                  "say": "Here. It's cold.",
                  "who": "lucky"
                }
              ]
            },
            {
              "text": "Nothing.",
              "then": [
                {
                  "say": "...",
                  "who": "phoenix"
                }
              ]
            }
          ]
        }
      ],
      "else": [
        {
          "inc": {
            "vars.phoenixTalks": 1
          }
        },
        {
          "if": "vars.phoenixTalks >= 3 && !inventory.has('coffee')",
          "then": [
            {
              "say": "Take this. Stop talking to me.",
              "who": "phoenix"
            },
            {
              "give": {
                "item": "coffee",
                "qty": 1
              }
            }
          ],
          "else": [
            {
              "say": "We've met.{pause:200} Twice now.",
              "who": "phoenix"
            }
          ]
        }
      ]
    },
    {
      "face": {
        "who": "phoenix",
        "dir": "down"
      }
    }
  ],
  "dev_sign": [
    {
      "say": "PALMER'S BAR\nLIVE MUSIC - NO COPS",
