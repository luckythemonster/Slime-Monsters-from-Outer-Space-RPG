    { "say": "[Yep.]", "who": "ryan_caption" }
  ],
  "ep0_room4_kit": [
    { "say": "The size of a sedan. The ride cymbal is tinny. Don't tell him.", "who": "narrator" },
    { "if": "flags.ryanQuit", "then": [
      { "say": "It is still here. He is not.", "who": "narrator" }
    ] }
  ],
  "ep0_room4_cymbal": [
    { "say": "The ride cymbal. It says TINNY on it in Sharpie. He wrote that. Nobody knows when.", "who": "narrator" }
  ],
  "ep0_room4_amp_lucky": [
    { "say": "Forty-one stickers. Nine are political. Brian counted.", "who": "narrator" },
    { "if": "flags.brianQuit", "then": [
      { "say": "Forty-two now. The new one says BRIAN WAS WRONG.", "who": "narrator" }
    ] }
