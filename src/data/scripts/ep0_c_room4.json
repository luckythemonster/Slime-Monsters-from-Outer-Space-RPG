  "ep0_room4_drip": [
    { "if": "flags.brianQuit", "then": [
      { "say": "The drip. It started again after the door slammed. It was waiting.", "who": "narrator" }
    ], "else": [
      { "say": "Slime drips from the ceiling. It has been a month. It is still dripping.", "who": "narrator" },
      { "say": "My brain thinks it's load-bearing now.", "who": "phoenix" }
