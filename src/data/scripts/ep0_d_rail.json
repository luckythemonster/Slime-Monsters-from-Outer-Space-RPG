    { "set": { "vars.railDir": 1, "vars.railStop": 0, "flags.railIntro": true } },
    { "teleport": { "map": "rail_car", "x": 3, "y": 7, "facing": "right" } },
    { "camera": { "fade": "in", "ms": 300 } },
    { "sfx": "rail_chime" },
    { "say": "THE BLUE LINE. Doors closing.{pause:400}\nThe doors close on Brian's pedalboard. Twice.", "who": "narrator" },
    { "if": "party.has('brian')", "then": [
      { "say": "{speed:fast}I'll stand. The board needs to stay level.", "who": "brian" }
    ] },
    { "say": "My brain thinks the seats are a trap anyway.", "who": "phoenix" },
    { "sfx": "pa_ding" },
    { "say": "NEXT STOP: LAKE ST / MIDTOWN. Then CITY SOUND.{pause:300}\n(It is not called that. Everyone calls it that.)", "who": "narrator" },
    { "if": "party.has('brian')", "then": [
      { "say": "Light rail is the most accurate way to travel. It's on a rail.", "who": "brian" }
    ] }
  ],

  "ep0_rail_board_out": [
