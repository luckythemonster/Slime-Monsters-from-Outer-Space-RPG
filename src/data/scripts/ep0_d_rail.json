  "ep0_rail_fare": [
    { "say": "Fare Compliance. A Vanguard partner. Proof of payment, please.", "who": "fare" },
    { "if": "party.has('brian')", "then": [
      { "say": "{speed:fast}Monthly pass. I'm a completely normal commuter.", "who": "brian" },
      { "say": "Valid. Have a normal night, sir.", "who": "fare" }
    ] },
    { "say": "Two dollars each. That's four.", "who": "fare" },
    { "run": "ep0_rail_fare_choice" }
  ],

  "ep0_rail_fare_choice": [
    { "if": "money >= 4", "then": [
      { "choice": [
        { "text": "Pay $4", "then": [
          { "take": { "money": 4 } },
          { "say": "My brain thinks that was dinner.", "who": "phoenix" },
          { "set": { "flags.farePaid_a": true, "flags.cleared_fare": true } }
        ] },
        { "text": "Take the ticket", "then": [ { "run": "ep0_rail_fare_ticket" } ] },
        { "text": "Refuse", "then": [ { "run": "ep0_rail_fare_refuse" } ] }
      ] }
    ], "else": [
      { "say": "My brain thinks we don't have four dollars.", "who": "phoenix" },
      { "choice": [
        { "text": "Take the ticket", "then": [ { "run": "ep0_rail_fare_ticket" } ] },
        { "text": "Refuse", "then": [ { "run": "ep0_rail_fare_refuse" } ] }
      ] }
    ] }
  ],

  "ep0_rail_fare_ticket": [
