  "npc_en_volunteer": [
    { "if": "!flags.metVolunteer", "then": [
      { "set": { "flags.metVolunteer": true } },
      { "say": "Welcome to Extreme Noise. There's no manager. There's a binder.", "who": "volunteer" },
      { "shop": "extreme_noise" }
    ], "else": [
      { "say": "Need anything? The binder says I have to ask.", "who": "volunteer" },
      { "if": "inventory.has('half_ounce')", "then": [
        { "choice": [
          { "text": "Shop", "then": [ { "shop": "extreme_noise" } ] },
          { "text": "Can I volunteer?", "then": [ { "say": "Meetings are Tuesdays. It's Thursday.", "who": "volunteer" } ] },
          { "text": "Sell the weed", "then": [
            { "say": "My brain thinks they don't buy that.", "who": "phoenix" },
            { "say": "We're a collective, not a dispensary.", "who": "volunteer" }
          ] },
          { "text": "Bye", "then": [] }
        ], "cancelIndex": 3 }
      ], "else": [
        { "choice": [
          { "text": "Shop", "then": [ { "shop": "extreme_noise" } ] },
          { "text": "Can I volunteer?", "then": [ { "say": "Meetings are Tuesdays. It's Thursday.", "who": "volunteer" } ] },
          { "text": "Bye", "then": [] }
        ], "cancelIndex": 2 }
      ] }
    ] }
  ],

  "npc_en_binder": [
