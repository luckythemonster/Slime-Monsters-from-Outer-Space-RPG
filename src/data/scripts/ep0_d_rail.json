{
  "ep0_rail_board_first": [
    { "sfx": "door" },
    { "camera": { "fade": "out", "ms": 300 } },
    { "if": "!flags.visited_city_sound_hall", "then": [
      { "caption": "THAT NIGHT", "ms": 1500 }
