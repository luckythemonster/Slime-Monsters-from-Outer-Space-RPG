    ] },
    { "say": "Two dollars each. That's four.", "who": "fare_senior" },
    { "if": "money >= 4", "then": [
      { "choice": [
        { "text": "Pay $4", "then": [
          { "take": { "money": 4 } },
          { "say": "My brain thinks that was dinner again.", "who": "phoenix" },
          { "set": { "flags.farePaid_c": true, "flags.cleared_fare_senior": true } }
