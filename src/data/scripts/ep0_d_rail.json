      { "say": "OPEN TIL 9. IT IS 8:51.", "who": "narrator" }
    ] }
  ],

  "npc_en_bin_punk": [ { "say": "PUNK A TO Z. Every band you have heard of, and four you haven't,\nfiled under the one you have.", "who": "narrator" } ],
  "npc_en_bin_hardcore": [ { "say": "HARDCORE. Alphabetized by how fast. Nobody agrees.", "who": "narrator" } ],
