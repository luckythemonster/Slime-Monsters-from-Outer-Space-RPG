  "npc_rail_bike": [ { "say": "A bike hangs from the ceiling hook.\nIt looks like it is being punished.", "who": "narrator" } ],

  "npc_rail_slush": [ { "say": "Slush tracked in from four stations.\nIt is not an enemy. Yet.", "who": "narrator" } ],

