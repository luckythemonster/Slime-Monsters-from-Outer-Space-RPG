        { "text": "Take the ticket", "then": [ { "run": "ep0_rail_fare_senior_ticket" } ] },
        { "text": "Refuse", "then": [ { "run": "ep0_rail_fare_senior_refuse" } ] }
      ] }
    ] }
  ],

  "ep0_rail_fare_senior_ticket": [
