  "npc_en_back_room": [ { "say": "VOLUNTEERS ONLY. Everyone is a volunteer. Still no.", "who": "narrator" } ],

  "npc_en_hours": [
    { "if": "flags.hasPalmersFlyer", "then": [
      { "say": "OPEN TIL 9. IT IS 8:51. AGAIN.", "who": "narrator" }
