        { "say": "{speed:slow}mmf.", "who": "dad" }
      ] },
      { "set": { "flags.speakerChecked": true } },
      { "end": true }
    ] },
    { "face": { "who": "player", "dir": "up" } },
    { "anim": { "who": "player", "key": "lucky_channel", "wait": true } },
