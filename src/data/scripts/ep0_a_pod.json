  "ep0_eject": [
    { "if": "!flags.podSpeakerSlapped", "then": [
      { "say": "An unnecessarily red button, locked out by PARENTAL OVERRIDE.", "who": "narrator" },
      { "anim": { "who": "speaker", "key": "obj_intercom_talk", "wait": false } },
      { "say": "You can't eject while I'm talking, Lucky. Safety is a core value.", "who": "dad" },
      { "end": true }
    ] },
    { "say": "An unnecessarily red button.", "who": "narrator" },
    { "choice": [
      { "text": "EJECT", "then": [] },
