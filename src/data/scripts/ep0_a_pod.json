    { "emote": { "who": "player", "type": "…" } },
    { "set": { "flags.podIntro": true } }
  ],

  "ep0_dad_1": [
    { "anim": { "who": "speaker", "key": "obj_intercom_talk", "wait": false } },
    { "say": "Your mother and I paid for the compression. The least you could do is market yourself.", "who": "dad" }
