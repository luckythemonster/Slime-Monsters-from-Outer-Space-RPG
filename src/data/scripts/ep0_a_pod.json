{
  "ep0_pod_intro": [
    { "music": "dental_plan" },
    { "sfx": "intercom_buzz" },
    { "anim": { "who": "speaker", "key": "obj_intercom_talk", "wait": false } },
    { "say": "I just don't understand the whole nonbinary thing.", "who": "dad", "portrait": "dad_grille" },
