  "ep0_dad_3": [
    { "anim": { "who": "speaker", "key": "obj_intercom_talk", "wait": false } },
    { "say": "Billy's parents say Billy 'found themself.' In a storage unit.", "who": "dad" }
  ],
  "ep0_dad_4": [
    { "anim": { "who": "speaker", "key": "obj_intercom_talk", "wait": false } },
    { "say": "…I can see the speaker light.", "who": "dad" }
  ],
  "ep0_dad_mmf": [
    { "say": "{speed:slow}mmf. mmmf.", "who": "dad" }
  ],

  "ep0_speaker": [
    { "if": "flags.podSpeakerSlapped", "then": [
      { "say": "The speaker is slimed. The slime is holding.", "who": "narrator" },
